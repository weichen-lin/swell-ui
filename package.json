{
  "name": "@weichenlin/swell-ui",
  "version": "0.7.0",
  "description": "Hand-built React components styled with Tailwind CSS v4.",
  "homepage": "https://swell-ui.wei-chen.dev/",
  "bugs": {
    "url": "https://github.com/weichen-lin/swell-ui/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weichen-lin/swell-ui.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./styles.css": "./dist/styles.css",
    "./typography.css": "./dist/typography.css",
    "./themes/flat.css": "./dist/themes/flat.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc -b",
    "lint": "vp check",
    "lint:fix": "vp check --fix",
    "format": "vp fmt",
    "knip": "knip",
    "prepare": "if [ -e .git ]; then lefthook install; fi",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "storybook": "NODE_OPTIONS=--disable-warning=DEP0205 storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "docs:dev": "pnpm build && pnpm --filter ./docs dev",
    "docs:build": "pnpm build && pnpm --filter ./docs build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.2",
    "lefthook": "^2.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.8",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0"
  },
  "packageManager": "pnpm@12.11.2"
}
